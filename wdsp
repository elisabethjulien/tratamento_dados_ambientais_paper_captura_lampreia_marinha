library(terra)
library(dplyr)
library(tidyr)

r <- rast("C:/Users/elili/Downloads/vento/wspd3.mean.nc")

# Fix coordinates
ext(r) <- c(0, 360, -90, 90)
crs(r) <- "EPSG:4326"

# Portugal crop
portugal_ext <- ext(349, 355, 35, 44)
wind_crop <- crop(r, portugal_ext)

plot(wind_crop)

wind_crop

# Convert to dataframe
df <- as.data.frame(wind_crop, xy = TRUE)

# Pivot layers
df_long <- pivot_longer(
  df,
  cols = starts_with("wspd3"),
  names_to = "Layer",
  values_to = "Wspd3"
)

# Correct dates
dates <- seq(as.Date("1800-01-01"), by = "month", length.out = nlyr(wind_crop))

# Match one date per layer
df_long$Date <- dates[match(df_long$Layer, names(wind_crop))]

# Convert cubed wind to speed
df_long$WindSpeed <- df_long$Wspd3^(1/3)

head(df_long)

df_long <- df_long %>%
  filter(!is.na(Wspd3), !is.na(WindSpeed))

unique(df_long$Date)

sort(unique(df_long$Date), decreasing = TRUE)

unique_grid <- df_long %>%
  distinct(x, y)

unique_grid


# Convert 0–360 longitudes to standard -180..180
grid_plot <- unique_grid %>%
  mutate(lon = x - 360,
         lat = y)

# Plot actual raster cells (2° x 2°)
ggplot() +
  borders("world", colour = "grey40", fill = "grey95") +
  
  # draw each raster cell as a square tile
  geom_tile(
    data = grid_plot,
    aes(x = lon, y = lat),
    width = 2,
    height = 2,
    fill = "skyblue",
    colour = "black",
    alpha = 0.5
  ) +
  
  # label cell centers
  geom_text(
    data = grid_plot,
    aes(x = lon, y = lat,
        label = paste0("(", lon, ", ", lat, ")")),
    size = 3
  ) +
  
  coord_quickmap(
    xlim = c(-11, -6),
    ylim = c(36, 43),
    expand = FALSE
  ) +
  
  labs(
    title = "Actual Raster Grid Cells Covering Portugal Area",
    x = "Longitude",
    y = "Latitude"
  ) +
  theme_minimal()


library(ggplot2)
