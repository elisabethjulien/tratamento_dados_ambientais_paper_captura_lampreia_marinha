portugal_ext <- ext(349, 355, 35, 44)

all_data <- list()

for (f in nc_files) {
  
  nc_file <- nc_open(f)
  on.exit(nc_close(nc_file), add = TRUE)
  
  tmax <- aperm(ncvar_get(nc_file, "precip"), c(2, 1, 3))
  lon <- ncvar_get(nc_file, "lon")
