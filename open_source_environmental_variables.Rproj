#AS A LOOP#
##################################################################"
library(ncdf4)
library(terra)
library(lubridate)

folder_path <- "C:/Users/elili/Downloads/tmax"

nc_files <- list.files(folder_path, pattern = "\\.nc$", full.names = TRUE)

portugal_ext <- ext(349, 355, 35, 44)

all_data <- list()

for (f in nc_files) {
  
  nc_file <- nc_open(f)
  on.exit(nc_close(nc_file), add = TRUE)
  
  tmax <- aperm(ncvar_get(nc_file, "tmax"), c(2, 1, 3))
  lon <- ncvar_get(nc_file, "lon")
  lat <- ncvar_get(nc_file, "lat")
  time_var <- ncvar_get(nc_file, "time")
  
  dates <- ymd_hms("1900-01-01 00:00:00") + hours(time_var)
  
  r <- rast(tmax)
  ext(r) <- c(min(lon), max(lon), min(lat), max(lat))
  crs(r) <- "EPSG:4326"
  
  r_crop <- crop(r, portugal_ext)
  
  file_df <- list()
  
  for (i in 1:nlyr(r_crop)) {
    
    df <- as.data.frame(r_crop[[i]], xy = TRUE)
    
    if (nrow(df) == 0) next
    
    #  Rename the value column to something consistent
    names(df)[3] <- "tmax"
    
    df$Date <- dates[i]
    df$File <- basename(f)
    
    file_df[[length(file_df) + 1]] <- df
  }
  
  all_data[[length(all_data) + 1]] <- do.call(rbind, file_df)
}

final_df <- do.call(rbind, all_data)


port_lookup <- data.frame(
  port = c("Porto", "Aveiro", "Caminha", "Viana do Castelo", "Figueira da Foz"),
  x = c(351.5115, 351.5115, 351.0122, 351.0122, 351.0122),
  y = c(41.13542, 40.63681, 41.63403, 41.63403, 40.13819)
)

final_tmax_rounded  <- tmax_daily_19762026  %>%
  mutate(
    x = round(x, 4),
    y = round(y, 4)
  )

port_lookup2 <- port_lookup %>%
  mutate(
    x = round(x, 4),
    y = round(y, 4)
  )


tmaxdaily_filtered <- final_tmax_rounded %>%
  semi_join(port_lookup2, by = c("x", "y"))

tmaxdaily_final <- tmaxdaily_filtered %>%
  left_join(
    port_lookup2 %>%
      mutate(porto_group = case_when(
        port == "Porto" ~ "porto",
        port == "Aveiro" ~ "aveiro",
        port %in% c("Viana do Castelo", "Caminha") ~ "vdc_cam",
        port == "Figueira da Foz" ~ "fig"
      )) %>%
      select(x, y, porto_group),
    by = c("x", "y")
  )

tmaxdaily_final %>%
  duplicated() %>%
  sum()

tmaxdaily_final_clean <- tmaxdaily_final %>%
  distinct()

write_csv(final_tmax,"C:/Users/elili/Downloads/tmax/tmax_daily_19792026.csv")

#Now for minimum temperatures 
folder_path <- "C:/Users/elili/Downloads/tmax/tmin"

# Get all NetCDF files
nc_files <- list.files(folder_path, pattern = "\\.nc$", full.names = TRUE)

# Portugal extent
portugal_ext <- ext(349, 355, 35, 44)

all_data <- list()

for (f in nc_files) {
  
  # Open file
  nc_file <- nc_open(f)
  
  # Read variables
  tmin <- aperm(ncvar_get(nc_file, "tmin"), c(2, 1, 3))   # lon, lat, time
  lon <- ncvar_get(nc_file, "lon")
  lat <- ncvar_get(nc_file, "lat")
  time_var <- ncvar_get(nc_file, "time")
  
  # Convert time to dates
  dates <- ymd_hms("1900-01-01 00:00:00") + hours(time_var)
  
  # Create raster
  r <- rast(tmin)
  ext(r) <- c(min(lon), max(lon), min(lat), max(lat))
  crs(r) <- "EPSG:4326"
  
  # Crop to Portugal
  r_crop <- crop(r, portugal_ext)
  
  # Extract each layer (time step)
  file_df <- list()
  
  for (i in 1:nlyr(r_crop)) {
    
    df <- as.data.frame(r_crop[[i]], xy = TRUE, na.rm = FALSE)
    
    if (nrow(df) == 0) next
    
    names(df)[3] <- "tmin"
    
    df$Date <- dates[i]
    df$File <- basename(f)
    
    file_df[[i]] <- df
  }
  
  # Combine layers for this file
  all_data[[length(all_data) + 1]] <- bind_rows(file_df)
  
  # Close file
  nc_close(nc_file)
}

# Final combined dataset
final_tmin <- bind_rows(all_data)

# Preview
head(final_tmin)

port_lookup <- data.frame(
  port = c("Porto", "Aveiro", "Caminha", "Viana do Castelo", "Figueira da Foz"),
  x = c(351.5115, 351.5115, 351.0122, 351.0122, 351.0122),
  y = c(41.13542, 40.63681, 41.63403, 41.63403, 40.13819)
)

final_tmin_rounded  <- final_tmin  %>%
  mutate(
    x = round(x, 4),
    y = round(y, 4)
  )

port_lookup2 <- port_lookup %>%
  mutate(
    x = round(x, 4),
    y = round(y, 4)
  )


tmindaily_filtered <- final_tmin_rounded %>%
  semi_join(port_lookup2, by = c("x", "y"))

tmindaily_final <- tmindaily_filtered %>%
  left_join(
    port_lookup2 %>%
      mutate(porto_group = case_when(
        port == "Porto" ~ "porto",
        port == "Aveiro" ~ "aveiro",
        port %in% c("Viana do Castelo", "Caminha") ~ "vdc_cam",
        port == "Figueira da Foz" ~ "fig"
      )) %>%
      select(x, y, porto_group),
    by = c("x", "y")
  )

tmindaily_final %>%
  duplicated() %>%
  sum()

tmindaily_final_clean <- tmindaily_final %>%
  distinct()

write_csv(final_tmin,"C:/Users/elili/Downloads/tmax/tmin_daily_19792026.csv")

 
