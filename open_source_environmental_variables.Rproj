############################################################################################
########################{{{{{  extraction of info of interest }}}}}#########################
########################{{{{{ CPC Global Unified Temperature }}}}}##########################
#####   downloaded from: https://psl.noaa.gov/data/gridded/data.cpc.globaltemp.html   ######
###################################     05/2025 ############################################    
############################################################################################

library(terra)
library(lubridate)
library(tidyr)
library(dplyr)
library(ncdf4)

# Open the NetCDF file and read variables
nc_file <- nc_open("C:/Users/elili/Downloads/tmax/tmax.1979.nc")
tmax <- aperm(ncvar_get(nc_file, "tmax"), c(2, 1, 3))  # Convert to [lon, lat, time]
lon <- ncvar_get(nc_file, "lon")
lat <- ncvar_get(nc_file, "lat")
time_var <- ncvar_get(nc_file, "time")

# Create SpatRaster from temperature data
r <- rast(tmax)
ext(r) <- c(min(lon), max(lon), min(lat), max(lat))
crs(r) <- "EPSG:4326"

# Crop the raster to Portugal's extent
portugal_ext <- ext(349, 355, 35, 44)
tmax_crop <- crop(r, portugal_ext)

# Convert to a tidy data frame with Lon, Lat, Date, and Temperature
dates <- ymd_hms("1900-01-01 00:00:00") + hours(time_var)

temp_matrix <- as.matrix(tmax_crop)

# Get latitudes and longitudes
lon <- xFromCol(tmax_crop, 1:ncol(tmax_crop))
lat <- yFromRow(tmax_crop, 1:nrow(tmax_crop))

# Create a dataframe holding Lat, Lon, and the temperature values
mat_df <- data.frame(
  Lon = rep(lon, each = nrow(tmax_crop)),
  Lat = rep(lat, times = ncol(tmax_crop)),
  Value = as.vector(temp_matrix)
)

# Now, replicate the dates to match the number of rows
dates_repeated <- rep(dates, each = nrow(tmax_crop))

# Add the Date column to mat_df
mat_df$Date <- dates_repeated


#######################################################"
#AS A LOOP#
##################################################################"
library(ncdf4)
library(terra)
library(lubridate)

folder_path <- "C:/Users/elili/Downloads/tmax"

nc_files <- list.files(folder_path, pattern = "\\.nc$", full.names = TRUE)

portugal_ext <- ext(349, 355, 35, 44)

all_data <- list()

for (f in nc_files) {
  
  nc_file <- nc_open(f)
  on.exit(nc_close(nc_file), add = TRUE)
  
  tmax <- aperm(ncvar_get(nc_file, "tmax"), c(2, 1, 3))
  lon <- ncvar_get(nc_file, "lon")
  lat <- ncvar_get(nc_file, "lat")
  time_var <- ncvar_get(nc_file, "time")
  
  dates <- ymd_hms("1900-01-01 00:00:00") + hours(time_var)
  
  r <- rast(tmax)
  ext(r) <- c(min(lon), max(lon), min(lat), max(lat))
  crs(r) <- "EPSG:4326"
  
  r_crop <- crop(r, portugal_ext)
  
  file_df <- list()
  
  for (i in 1:nlyr(r_crop)) {
    
    df <- as.data.frame(r_crop[[i]], xy = TRUE)
    
    if (nrow(df) == 0) next
    
    #  Rename the value column to something consistent
    names(df)[3] <- "tmax"
    
    df$Date <- dates[i]
    df$File <- basename(f)
    
    file_df[[length(file_df) + 1]] <- df
  }
  
  all_data[[length(all_data) + 1]] <- do.call(rbind, file_df)
}

final_df <- do.call(rbind, all_data)

write.csv(final_df, "C:/Users/elili/Downloads/tmax/tmax_daily_19762026.csv")

#Now for minimum temperatures 
folder_path <- "C:/Users/elili/Downloads/tmax/tmin"

# Get all NetCDF files
nc_files <- list.files(folder_path, pattern = "\\.nc$", full.names = TRUE)

# Portugal extent
portugal_ext <- ext(349, 355, 35, 44)

all_data <- list()

for (f in nc_files) {
  
  # Open file
  nc_file <- nc_open(f)
  
  # Read variables
  tmin <- aperm(ncvar_get(nc_file, "tmin"), c(2, 1, 3))   # lon, lat, time
  lon <- ncvar_get(nc_file, "lon")
  lat <- ncvar_get(nc_file, "lat")
  time_var <- ncvar_get(nc_file, "time")
  
  # Convert time to dates
  dates <- ymd_hms("1900-01-01 00:00:00") + hours(time_var)
  
  # Create raster
  r <- rast(tmin)
  ext(r) <- c(min(lon), max(lon), min(lat), max(lat))
  crs(r) <- "EPSG:4326"
  
  # Crop to Portugal
  r_crop <- crop(r, portugal_ext)
  
  # Extract each layer (time step)
  file_df <- list()
  
  for (i in 1:nlyr(r_crop)) {
    
    df <- as.data.frame(r_crop[[i]], xy = TRUE, na.rm = FALSE)
    
    if (nrow(df) == 0) next
    
    names(df)[3] <- "tmin"
    
    df$Date <- dates[i]
    df$File <- basename(f)
    
    file_df[[i]] <- df
  }
  
  # Combine layers for this file
  all_data[[length(all_data) + 1]] <- bind_rows(file_df)
  
  # Close file
  nc_close(nc_file)
}

# Final combined dataset
final_tmin <- bind_rows(all_data)

# Preview
head(final_tmin)

write_csv(final_tmin,"C:/Users/elili/Downloads/tmax/tmin_daily_19792026.csv"

 


